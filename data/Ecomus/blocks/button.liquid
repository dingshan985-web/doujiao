{% liquid
  assign effect = 'hdt-reveal="slide-in" timeline'
  if section.id contains 'slideshow'
    assign effect = 'reval'
  endif
%}
{%- if block.settings.enable_advanced_layout -%}
  <div id="button-wrap-{{ block.id }}" class="hdt-button-block-wrap">
{%- endif -%}
<a {{ effect }} id="block-{{ block.id }}" {% if block.settings.link == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.link }}"{% endif %} class="hdt-button-block hdt-btn hdt-relative hdt-oh hdt-font-{{ block.settings.font_weight }} hdt-btn--size-{{ block.settings.font_size }} hdt-btn-{{ block.settings.style_class }}{% if block.settings.full_width %} hdt-btn-full-width{% endif %}{% if block.settings.icon != "none" %} hdt-btn--with-icon  hdt-btn--pos-icon-{{ block.settings.icon_position }}{% endif %}"{% if block.settings.icon != "none" %} style="--gap-btn-icon: {{ block.settings.icon_spacing }}px; --height-btn-icon: {{ block.settings.icon_height }}px"{% endif %} {% if block.settings.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif -%} {{ block.shopify_attributes }}>
  {%- liquid
  if block.settings.icon != 'none'
    render 'icons', icon: block.settings.icon
  endif
  echo block.settings.label
  -%}
</a>
{%- if block.settings.enable_advanced_layout -%}
  </div>
{%- endif -%}
{%- if block.settings.font_size == "custom custom-inline" -%}
  {%- style -%}
    #block-{{ block.id }} {
      --padding-button: 5px {{ block.settings.padding_btn }}px; --height-button: {{ block.settings.min_height_btn }}px; --font-size-button: {{ block.settings.font_size_btn }}px;--min-width-btn: {{ block.settings.min_width_btn }}px; --min-width-btn-dt: {{ block.settings.min_width_dt_btn }}px;
    }
  {%- endstyle -%}
{%- endif -%}
{%- if block.settings.enable_advanced_layout -%}
  {%- style -%}
    #button-wrap-{{ block.id }} {
      position: relative;
      left: {{ block.settings.advanced_offset_x_mb }}px;
      margin-top: {{ block.settings.advanced_margin_top_mb }}px;
      margin-bottom: {{ block.settings.advanced_margin_bottom_mb }}px;
      text-align: {{ block.settings.advanced_alignment_mb }};
    }
    #block-{{ block.id }} {
      min-width: 0;
      min-height: {{ block.settings.advanced_height_mb }}px;
      padding: 5px {{ block.settings.advanced_padding_x_mb }}px;
      font-size: {{ block.settings.advanced_font_size_mb }}px;
      border-radius: {{ block.settings.advanced_border_radius }}px;
      {% case block.settings.advanced_width_mode_mb %}
        {% when 'full' %}width: 100%;
        {% when 'custom' %}width: {{ block.settings.advanced_width_mb }}px; max-width: 100%;
        {% else %}width: auto;
      {% endcase %}
    }
    @media (min-width: 1150px) {
      #button-wrap-{{ block.id }} {
        left: {{ block.settings.advanced_offset_x_lg }}px;
        margin-top: {{ block.settings.advanced_margin_top_lg }}px;
        margin-bottom: {{ block.settings.advanced_margin_bottom_lg }}px;
        text-align: {{ block.settings.advanced_alignment_lg }};
      }
      #block-{{ block.id }} {
        min-width: 0;
        min-height: {{ block.settings.advanced_height_lg }}px;
        padding: 5px {{ block.settings.advanced_padding_x_lg }}px;
        font-size: {{ block.settings.advanced_font_size_lg }}px;
        {% case block.settings.advanced_width_mode_lg %}
          {% when 'full' %}width: 100%;
          {% when 'custom' %}width: {{ block.settings.advanced_width_lg }}px; max-width: 100%;
          {% else %}width: auto;
        {% endcase %}
      }
    }
  {%- endstyle -%}
{%- endif -%}
