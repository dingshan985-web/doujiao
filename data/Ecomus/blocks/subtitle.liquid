{% liquid
  assign effect = 'hdt-reveal="slide-in" timeline'
  if section.id contains 'slideshow'
    assign effect = 'reval'
  endif

  assign color_class = block.settings.text_color
  assign custom_color_style = ''
  if block.settings.text_color == 'custom' and block.settings.custom_text_color != blank
    assign color_class = ''
    assign custom_color_alpha = block.settings.custom_color_opacity | divided_by: 100.0
    assign custom_color_value = block.settings.custom_text_color | color_modify: 'alpha', custom_color_alpha
    assign custom_color_style = 'color: ' | append: custom_color_value | append: ';'
  endif
%}

<div
  {{ effect }}
  id="block-{{ block.id }}"
  class="ecomus-subtitle hdt-rte {{ color_class }}{% if block.settings.hidden_on_mobile %} hdt-hide-mobile{% endif %}"
  style="{{ custom_color_style }}"
  {{ block.shopify_attributes }}
>
  {{ block.settings.text }}
</div>

{% style %}
  #block-{{ block.id }} {
    font-family: {% if block.settings.font_family != blank %}var({{ block.settings.font_family }}){% else %}inherit{% endif %};
    font-size: {{ block.settings.font_size_mb }}px;
    font-style: {{ block.settings.font_style }};
    font-weight: {{ block.settings.font_weight }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
    line-height: {{ block.settings.line_height }};
    max-width: {% if block.settings.max_width_mb > 0 %}{{ block.settings.max_width_mb }}px{% else %}none{% endif %};
    margin-top: {{ block.settings.margin_top_mb }}px;
    margin-bottom: {{ block.settings.margin_bottom_mb }}px;
    text-transform: {{ block.settings.text_transform }};
    text-align: {% if block.settings.alignment_mb == 'inherit' %}inherit{% else %}{{ block.settings.alignment_mb }}{% endif %};
    {% case block.settings.alignment_mb %}
      {% when 'left' %}margin-left: 0; margin-right: auto;
      {% when 'center' %}margin-left: auto; margin-right: auto;
      {% when 'right' %}margin-left: auto; margin-right: 0;
      {% else %}margin-left: 0; margin-right: 0;
    {% endcase %}
  }
  #block-{{ block.id }} > * {
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    line-height: inherit;
    margin-top: 0;
    margin-bottom: 0;
    text-align: inherit;
    text-transform: inherit;
  }
  @media (min-width: 768px) {
    #block-{{ block.id }} {
      font-size: {{ block.settings.font_size_md }}px;
    }
  }
  @media (min-width: 1150px) {
    #block-{{ block.id }} {
      font-size: {{ block.settings.font_size_lg }}px;
      max-width: {% if block.settings.max_width_lg > 0 %}{{ block.settings.max_width_lg }}px{% else %}none{% endif %};
      margin-top: {{ block.settings.margin_top_lg }}px;
      margin-bottom: {{ block.settings.margin_bottom_lg }}px;
      text-align: {% if block.settings.alignment_lg == 'inherit' %}inherit{% else %}{{ block.settings.alignment_lg }}{% endif %};
      {% case block.settings.alignment_lg %}
        {% when 'left' %}margin-left: 0; margin-right: auto;
        {% when 'center' %}margin-left: auto; margin-right: auto;
        {% when 'right' %}margin-left: auto; margin-right: 0;
        {% else %}margin-left: 0; margin-right: 0;
      {% endcase %}
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "副标题",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "副标题内容",
      "default": "精选系列"
    },
    {
      "type": "checkbox",
      "id": "hidden_on_mobile",
      "label": "在移动端隐藏",
      "default": false
    },
    {
      "type": "header",
      "content": "颜色"
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "颜色来源",
      "options": [
        { "value": "hdt-s-text", "label": "主题默认" },
        { "value": "hdt-text-secondary", "label": "辅助" },
        { "value": "hdt-text-body-tertiary", "label": "次要" },
        { "value": "hdt-text-primary", "label": "强调" },
        { "value": "custom", "label": "自定义" }
      ],
      "default": "hdt-s-text"
    },
    {
      "type": "color",
      "id": "custom_text_color",
      "label": "自定义颜色",
      "default": "#000000",
      "visible_if": "{{ block.settings.text_color == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_color_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "颜色不透明度",
      "default": 100,
      "visible_if": "{{ block.settings.text_color == 'custom' }}"
    },
    {
      "type": "header",
      "content": "字体"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "字体系列",
      "options": [
        { "value": "", "label": "继承主题" },
        { "value": "--f_family_1", "label": "字体 1" },
        { "value": "--f_family_2", "label": "字体 2" },
        { "value": "--f_family_3", "label": "字体 3" },
        { "value": "--f_family_4", "label": "字体 4" },
        { "value": "--f_family_5", "label": "字体 5" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "font_size_lg",
      "min": 10,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "桌面字号",
      "default": 18
    },
    {
      "type": "range",
      "id": "font_size_md",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "平板字号",
      "default": 16
    },
    {
      "type": "range",
      "id": "font_size_mb",
      "min": 10,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "移动端字号",
      "default": 14
    },
    {
      "type": "range",
      "id": "font_weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "label": "字体粗细",
      "default": 500
    },
    {
      "type": "range",
      "id": "line_height",
      "min": 0.8,
      "max": 2,
      "step": 0.1,
      "label": "行高",
      "default": 1.2
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": -5,
      "max": 10,
      "step": 0.2,
      "unit": "px",
      "label": "字间距",
      "default": 0
    },
    {
      "type": "select",
      "id": "font_style",
      "label": "字体样式",
      "options": [
        { "value": "normal", "label": "正常" },
        { "value": "italic", "label": "斜体" }
      ],
      "default": "normal"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "字母大小写",
      "options": [
        { "value": "none", "label": "保持原样" },
        { "value": "uppercase", "label": "全部大写" },
        { "value": "lowercase", "label": "全部小写" },
        { "value": "capitalize", "label": "单词首字母大写" }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "桌面布局"
    },
    {
      "type": "select",
      "id": "alignment_lg",
      "label": "桌面对齐",
      "options": [
        { "value": "inherit", "label": "继承幻灯片" },
        { "value": "left", "label": "左对齐" },
        { "value": "center", "label": "居中" },
        { "value": "right", "label": "右对齐" }
      ],
      "default": "inherit"
    },
    {
      "type": "range",
      "id": "max_width_lg",
      "min": 0,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "桌面最大宽度",
      "default": 0,
      "info": "0 表示不限制。"
    },
    {
      "type": "range",
      "id": "margin_top_lg",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "桌面上间距",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_lg",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "桌面下间距",
      "default": 12
    },
    {
      "type": "header",
      "content": "移动端布局"
    },
    {
      "type": "select",
      "id": "alignment_mb",
      "label": "移动端对齐",
      "options": [
        { "value": "inherit", "label": "继承幻灯片" },
        { "value": "left", "label": "左对齐" },
        { "value": "center", "label": "居中" },
        { "value": "right", "label": "右对齐" }
      ],
      "default": "inherit"
    },
    {
      "type": "range",
      "id": "max_width_mb",
      "min": 0,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "移动端最大宽度",
      "default": 0,
      "info": "0 表示不限制。"
    },
    {
      "type": "range",
      "id": "margin_top_mb",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "移动端上间距",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_mb",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "移动端下间距",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "副标题"
    }
  ]
}
{% endschema %}
