                  {%- assign bh_subtotal_cents = bh_unit_price | times: bh_init_qty -%}
                  <div class="bh-subtotal" data-bh-subtotal data-section-id="{{ section.id }}" data-unit-price-cents="{{ bh_unit_price }}">
                    <span class="bh-subtotal__label">Subtotal:</span>
                    <span class="bh-subtotal__value" data-bh-subtotal-value>${{ bh_subtotal_cents | money_without_currency }}</span>
                  </div>
                  <style>
                    .bh-subtotal {
                      margin-top: 10px;
                      font-size: 1.4rem;
                      line-height: 1.4;
                      color: rgb(var(--color-foreground));
                    }
                    .bh-subtotal__label {
                      font-weight: 600;
                    }
                    .bh-subtotal__value {
                      font-weight: 700;
                    }
                  </style>
                  <script>
                    (function () {
                      function bhFormatMoney(cents) {
                        cents = parseFloat(cents) || 0;
                        return '$' + (cents / 100).toFixed(2);
                      }
                      function bhInitSubtotal(sectionId) {
                        var wrap = document.querySelector('.bh-subtotal[data-section-id="' + sectionId + '"]');
                        if (!wrap) return;
                        var valueEl = wrap.querySelector('[data-bh-subtotal-value]');
                        var qtyInput = document.getElementById('Quantity-' + sectionId);
                        if (!valueEl || !qtyInput) return;
                        var unitPrice = parseFloat(wrap.getAttribute('data-unit-price-cents')) || 0;
                        function update() {
                          var qty = parseInt(qtyInput.value, 10);
                          if (isNaN(qty) || qty < 0) qty = 0;
                          valueEl.textContent = bhFormatMoney(unitPrice * qty);
                        }
                        qtyInput.addEventListener('change', update);
                        qtyInput.addEventListener('input', update);
                        if (typeof subscribe === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
                          subscribe(PUB_SUB_EVENTS.variantChange, function (event) {
                            if (!event || !event.data || event.data.sectionId !== sectionId) return;
                            if (event.data.variant && typeof event.data.variant.price !== 'undefined') {
                              unitPrice = event.data.variant.price;
                              update();
                            }
                          });
                        }
                        update();
                      }
                      function bhInitAll() {
                        document.querySelectorAll('.bh-subtotal').forEach(function (w) {
                          bhInitSubtotal(w.getAttribute('data-section-id'));
                        });
                      }
                      if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', bhInitAll);
                      } else {
                        bhInitAll();
                      }
                    })();
                  </script>
