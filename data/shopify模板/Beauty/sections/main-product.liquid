                              <modal-opener
                                  class="product-popup-modal__opener no-js-hidden quick-add-hidden"
                                  data-modal="#PopupModal-{{ block.id }}"
                                 style="display:flex;"
                                >
                                  <button
                                    id="ProductPopup-{{ block.id }}"
                                    class="form__label form__label-variant_picker product-popup-modal__button link lumin-popup {% if block.settings.label_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.label_style == 'subtitle' %} subtitle{% endif %}"
                                    type="button"
                                    aria-haspopup="dialog"
                                  >
                                    {{ size_chart_title }}
                                  </button>
                                </modal-opener>
                                <a href="{{ block.settings.size_page.url }}" class="product-popup-modal__button link no-js">
                                  {{- block.settings.text -}}
                                </a>
                                  <modal-dialog id="PopupModal-{{ block.id }}" class="product-popup-modal" {{ block.shopify_attributes }}>
                                      <div
                                        role="dialog"
                                        aria-label="{{ block.settings.text }}"
                                        aria-modal="true"
                                        class="product-popup-modal__content"
                                        tabindex="-1"
                                      >
                                        <button
                                          id="ModalClose-{{ block.id }}"
                                          type="button"
                                          class="product-popup-modal__toggle"
                                          aria-label="{{ 'accessibility.close' | t }}"
                                        >
                                          {% render 'icon-close' %}
                                        </button>
                                        <div class="product-popup-modal__content-info">
                                          <h1 class="h2">{{ block.settings.chart_id }}</h1>
                                          {{ block.settings.size_page.content }}
