        },
        {
          "type": "color",
          "id": "hover_background_color",
          "label": "悬停背景颜色",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "边框颜色",
          "default": "#000000"
        }
      ]
    }
  ]
}
