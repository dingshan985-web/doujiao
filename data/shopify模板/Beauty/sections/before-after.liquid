              "label": "右"
            },
            {
              "value": "center",
              "label": "居中"
            }
          ],
          "default": "center"
        },
        {
          "type": "range",
          "id": "width",
          "label": "宽度",
          "min": 50,
          "max": 500,
          "step": 5,
          "default": 160,
          "unit": "px"
        },
         {
          "type": "range",
          "id": "font_size",
          "label": "字号",
          "min": 10,
          "max": 100,
          "step": 1,
          "default": 16,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "border_radius",
          "label": "边框圆角",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 10,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "border_width",
          "label": "边框宽度",
          "min": 0,
          "max": 10,
          "step": 1,
