          "unit": "px"
        },
        {
          "type":"header",
          "content":"颜色"
        },
        {
          "type": "color",
          "id": "color",
          "label": "文本颜色",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "背景颜色",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "hover_color",
          "label": "悬停文本颜色",
