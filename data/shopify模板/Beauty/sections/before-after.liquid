          "id": "before_text",
          "label": "对比前文本",
          "default": "Before"
        },
        {
          "type": "text",
          "id": "after_text",
          "label": "对比后文本",
          "default": "After"
        },
        {
          "type": "select",
          "id": "before_after_text_position",
          "label": "对比前后文本位置",
          "options": [
            {
              "value": "bottom",
              "label": "底部"
            },
            {
              "value": "top",
              "label": "顶部"
            }
          ],
          "default": "bottom"
        },
        {
