{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
  if section.settings.color_scheme == section.settings.section_color_scheme and section.settings.content_layout == 'no-overlap'
    assign remove_color_classes = true
  endif
-%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.section_color_scheme }}">
  <div class="page-width">
    <div class="image-with-text image-with-text--{{ section.settings.content_layout }} isolate{% if settings.text_boxes_border_thickness > 0 and settings.text_boxes_border_opacity > 0 and settings.media_border_thickness > 0 and settings.media_border_opacity > 0 %} collapse-borders{% endif %}{% unless section.settings.color_scheme == section.settings.section_color_scheme and settings.media_border_thickness > 0 and settings.text_boxes_shadow_opacity == 0 and settings.text_boxes_border_thickness == 0 or settings.text_boxes_border_opacity == 0 %} collapse-corners{% endunless %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <div class="image-with-text__grid grid grid--gapless grid--1-col grid--{% if section.settings.desktop_image_width == 'medium' %}2-col-tablet{% else %}3-col-tablet{% endif %}{% if section.settings.layout == 'text_first' %} image-with-text__grid--reverse{% endif %}">
        <div class="image-with-text__media-item image-with-text__media-item--{{ section.settings.desktop_image_width }} image-with-text__media-item--{{ section.settings.desktop_content_position }} grid__item">
          <div
            class="image-with-text__media image-with-text__media--{{ section.settings.height }} global-media-settings{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}{% if section.settings.image != blank %} media{% else %} image-with-text__media--placeholder placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}"
            {% if section.settings.height == 'adapt' and section.settings.image != blank %}
              style="padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;"
            {% endif %}
          >
            {%- if section.settings.image != blank -%}
              {%- if section.settings.image_behavior == 'ambient' or section.settings.image_behavior == 'zoom-in' -%}
                {%- assign widths = '198, 432, 642, 900, 1284, 1800' -%}
                {%- capture sizes -%}
              (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 1.6667 }}px,
              (min-width: 750px) calc((100vw - 130px) / 1.667), calc((100vw - 50px) / 1.667)
            {%- endcapture -%}
              {%- else -%}
                {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
                {%- capture sizes -%}
              (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
              (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)
            {%- endcapture -%}
              {%- endif -%}
              {{
                section.settings.image
                | image_url: width: 1500
                | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>
        <div class="image-with-text__text-item grid__item">
          <div
            id="ImageWithText--{{ section.id }}"
            class="image-with-text__content image-with-text__content--{{ section.settings.desktop_content_position }} image-with-text__content--desktop-{{ section.settings.desktop_content_alignment }} image-with-text__content--mobile-{{ section.settings.mobile_content_alignment }} image-with-text__content--{{ section.settings.height }} content-container{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}"
          >
            {%- for block in section.blocks -%}
              {% case block.type %}
                {%- when 'heading' -%}
                  <h2
                    class="image-with-text__heading inline-richtext {{ block.settings.heading_size }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.heading | replace: '[', '<span class="lumin-text__fancy1">' | replace: ']', '</span>' | replace: '((', '<span class="lumin-text__fancy2">' | replace: '))', '</span>' }}
                  </h2>
                {%- when 'caption' -%}
                  <p
                    class="image-with-text__text image-with-text__text--caption {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }} {{ block.settings.text_style }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.caption | escape }}
                  </p>
                {%- when 'text' -%}
                  <div class="image-with-text__text rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
                    {{ block.settings.text | replace: '[', '<span class="lumin-text__fancy1">' | replace: ']', '</span>' | replace: '((', '<span class="lumin-text__fancy2">' | replace: '))', '</span>' }}
                  </div>
                {%- when 'testimonial-images' -%}
            {{ 'image-bar.css' | asset_url | stylesheet_tag }}
                 
                 <div class="lm-tot-bar"
                   style="--bar-font-size:{{block.settings.text_size}}px;
                          --bar-zoom:{{block.settings.image_size}};
                          --bar-image-space:{{block.settings.image_space}}px;"
                   >
                   <div class="lm-img-bar" {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    <span> 
                      {{ block.settings.image | image_url: width: 100  | image_tag  }}
                    </span>

                  {%- else -%}
                    {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                     {%- unless block.settings.hide_img_2  -%}
                  {%- if block.settings.image_2 != blank -%}
                    <span> 
                      {{ block.settings.image_2 | image_url: width: 100  | image_tag  }}
                    </span>
                  {%- else -%}
                    {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                    {% endunless %}
                     {%- unless block.settings.hide_img_3  -%}
                  {%- if block.settings.image_3 != blank -%}
                    <span> 
                      {{ block.settings.image_3 | image_url: width: 100  | image_tag  }}
                    </span>
                  {%- else -%}
                    {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                     {% endunless %}
                     {%- unless block.settings.hide_img_4  -%}
                  {%- if block.settings.image_4 != blank -%}
                   <span> 
                      {{ block.settings.image_4 | image_url: width: 100  | image_tag  }}
                    </span>
                  {%- else -%}
                    {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                     {% endunless %}
                     {%- unless block.settings.hide_img_5  -%}
                  {%- if block.settings.image_5 != blank -%}
                    <span> 
                      {{ block.settings.image_5 | image_url: width: 100  | image_tag  }}
                    </span>
                  {%- else -%}
                    {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                     {% endunless %}
                </div>
                   {{ block.settings.text | replace: '[', '<span class="lumin-text__fancy1">' | replace: ']', '</span>' | replace: '((', '<span class="lumin-text__fancy2">' | replace: '))', '</span>' }}
                 </div>

                {%- when 'button' -%}
                  {%- if block.settings.button_label != blank -%}
                    <a
                      {% if block.settings.button_link == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ block.settings.button_link }}"
                      {% endif %}
                      class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.button_label | escape }}
                    </a>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "带文本的图片",
  "class": "section",
   "disabled_on": {
  "groups": ["header", "footer", "custom.popup"]
   },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "图片"
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        {
          "value": "adapt",
          "label": "适应图片"
        },
        {
          "value": "small",
          "label": "小"
        },
        {
          "value": "medium",
          "label": "中"
        },
        {
          "value": "large",
          "label": "大"
        }
      ],
      "default": "adapt",
      "label": "图片高度"
    },
    {
      "type": "select",
      "id": "desktop_image_width",
      "options": [
        {
          "value": "small",
          "label": "小"
        },
        {
          "value": "medium",
          "label": "中"
        },
        {
          "value": "large",
          "label": "大"
        }
      ],
      "default": "medium",
      "label": "台式设备图片宽度",
      "info": "图片会针对移动设备进行自动优化。"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "image_first",
          "label": "图片优先"
        },
        {
          "value": "text_first",
          "label": "第二张图片"
        }
      ],
      "default": "image_first",
      "label": "台式设备图片放置",
      "info": "图片优先是默认的移动布局。"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        {
          "value": "top",
          "label": "顶部"
        },
        {
          "value": "middle",
          "label": "中间"
        },
        {
          "value": "bottom",
          "label": "底部"
        }
      ],
      "default": "top",
      "label": "台式设备内容位置"
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "options": [
        {
          "value": "left",
          "label": "左"
        },
        {
          "value": "center",
          "label": "居中"
        },
        {
          "value": "right",
          "label": "右"
        }
      ],
      "default": "left",
      "label": "台式设备内容对齐方式"
    },
    {
      "type": "select",
      "id": "content_layout",
      "options": [
        {
          "value": "no-overlap",
          "label": "无重叠"
        },
        {
          "value": "overlap",
          "label": "重叠"
        }
      ],
      "default": "no-overlap",
      "label": "内容布局"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "配色方案",
      "default": "background-1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "容器配色方案",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "动画"
    },
    {
      "type": "select",
      "id": "image_behavior",
      "options": [
        {
          "value": "none",
          "label": "无"
        },
        {
          "value": "ambient",
          "label": "环境移动"
        },
        {
          "value": "zoom-in",
          "label": "滚动时放大"
        }
      ],
      "default": "none",
      "label": "图片行为"
    },
    {
      "type": "header",
      "content": "移动端布局"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "options": [
        {
          "value": "left",
          "label": "左"
        },
        {
          "value": "center",
          "label": "居中"
        },
        {
          "value": "right",
          "label": "右"
        }
      ],
      "default": "left",
      "label": "移动设备内容对齐方式"
    },
    {
      "type": "header",
      "content": "分区填充"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "顶部填充",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "底部填充",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "标题",
      "limit": 2,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Image with text",
          "label": "标题"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h2",
              "label": "小"
            },
            {
              "value": "h1",
              "label": "中"
            },
            {
              "value": "h0",
              "label": "大"
            }
          ],
          "default": "h1",
          "label": "标题大小"
        }
      ]
    },
    {
      "type": "caption",
      "name": "字幕",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "caption",
          "default": "Add a tagline",
          "label": "文本"
        },
        {
          "type": "select",
          "id": "text_style",
          "options": [
            {
              "value": "subtitle",
              "label": "副标题"
            },
            {
              "value": "caption-with-letter-spacing",
              "label": "大写"
            }
          ],
          "default": "caption-with-letter-spacing",
          "label": "文本样式"
        },
        {
          "type": "select",
          "id": "text_size",
          "options": [
            {
              "value": "small",
              "label": "小"
            },
            {
              "value": "medium",
              "label": "中"
            },
            {
              "value": "large",
              "label": "大"
            }
          ],
          "default": "medium",
          "label": "文本大小"
        }
      ]
    },
    {
      "type": "text",
      "name": "文本",
      "limit": 3,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>",
          "label": "内容"
        },
        {
          "type": "select",
          "id": "text_style",
          "options": [
            {
              "value": "body",
              "label": "正文"
            },
            {
              "value": "subtitle",
              "label": "副标题"
            }
          ],
          "default": "body",
          "label": "文本样式"
        }
      ]
    },
    {
      "type": "testimonial-images",
      "name": "评价图片",
      "settings": [
              {
          "type": "range",
          "id": "image_size",
          "label": "图片横条大小",
          "min":       0.5,
          "max":        2,
          "step":       0.1,
          "default": 1
          },
        {
          "type": "range",
          "id": "image_space",
          "label": "图片间距",
          "min":       -30,
          "max":        10,
          "step":       1,
          "default": -18
          },
             {
              "type": "image_picker",
              "id": "image",
              "label": "图片"
            },
        {
          "type": "checkbox",
          "id": "hide_img_2",
          "label": "隐藏图片2",
          "default": false
        },
        {
              "type": "image_picker",
              "id": "image_2",
              "label": "图片"
            },
        {
          "type": "checkbox",
          "id": "hide_img_3",
          "label": "隐藏图片3",
          "default": false
        },
         {
              "type": "image_picker",
              "id": "image_3",
              "label": "图片"
            },
        {
          "type": "checkbox",
          "id": "hide_img_4",
          "label": "隐藏图片4",
          "default": false
        },
         {
              "type": "image_picker",
              "id": "image_4",
              "label": "图片"
            },
        {
          "type": "checkbox",
          "id": "hide_img_5",
          "label": "隐藏图片5",
          "default": false
        },
        {
              "type": "image_picker",
              "id": "image_5",
              "label": "图片"
            },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>★★★★★ Excellent 4.8</p>",
          "label": "内容"
        },
           {
          "type": "range",
          "id": "text_size",
          "label": "文本大小",
          "min":       8,
          "max":        30,
          "step":       1,
          "default": 13
          },
        {
          "type": "select",
          "id": "text_style",
          "options": [
            {
              "value": "body",
              "label": "正文"
            },
            {
              "value": "subtitle",
              "label": "副标题"
            }
          ],
          "default": "body",
          "label": "文本样式"
        }
      ]
    },
    {
      "type": "button",
      "name": "按钮",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "default": "Button label",
          "label": "按钮标签",
          "info": "将标签留空以隐藏按钮。"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "按钮链接"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary",
          "default": false,
          "label": "使用轮廓按钮样式"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "带文本的图片",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
