{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .section-{{ section.id }}-margin {
    padding-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-margin {
      padding-top: {{ section.settings.margin_top }}px;
      padding-bottom: {{ section.settings.margin_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-margin">
  <div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
    <div class="page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
      >
      <!--
        Header
        <div class="header-collage">
          <h1>Responsive Image Grid</h1>
          <p>Resize the browser window to see the responsive effect.</p>
        </div>
      -->

      <!-- Photo Grid -->
      <div class="row-{{ section.id }}">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'image' %}
              <style>
                .column-{{ block.id }} {
                  /*flex: calc({{ block.settings.grid_width_desktop}}% - {{ section.settings.grid_gap }}px);*/
                  width: calc({{ block.settings.grid_width_desktop}}% - {{ section.settings.grid_gap }}px);
                  position:relative;
                }
                   @media screen and (max-width: 600px) {
                  .column-{{ block.id }} {
                    width: 100%;
                  }
                }
                  @media screen and (min-width: 601px) and (max-width: 990px) {
                  .column-{{ block.id }} {
                    /*flex: calc({{ block.settings.grid_width_tablet}}% - {{ section.settings.grid_gap }}px);*/
                    width: calc({{ block.settings.grid_width_tablet}}% - {{ section.settings.grid_gap }}px);
                  }
                }

                 .lumin-text-container-{{ block.id }} {
                    margin: 0;
                    display: flex;
                    width: 100%;
                    height: 100%;
                    position: absolute;
                    top: 0;
                    left: 0;
                    padding: {{block.settings.padding_size}}px;
                    object-fit: cover;
                    z-index: 2;
                    align-items: center;
                    justify-content: flex-start;
                  }
                .lumin-text-container-{{ block.id }}:before {
                    content: "";
                    width: 100%;
                    height: 100%;
                    position: absolute;
                    top: 0;
                    left: 0;
                    padding: {{block.settings.padding_size}}px;
                    object-fit: cover;
                    z-index: 0;
                    align-items: center;
                    justify-content: flex-start;
                   {% unless block.settings.opacity_color_full %}
                    background: {{block.settings.opacity_color}};
                    opacity: {{block.settings.overlay_opacity}}%;
                    {% endunless %}
                  }
                  .image-text-content-{{ block.id }}--top-left {
                    align-items: flex-start;
                    justify-content: flex-start;
                  }

                  .image-text-content-{{ block.id }}--top-center {
                    align-items: flex-start;
                    justify-content: center;
                  }

                  .image-text-content-{{ block.id }}--top-right {
                    align-items: flex-start;
                    justify-content: flex-end;
                  }

                  .image-text-content-{{ block.id }}--middle-left {
                    align-items: center;
                    justify-content: flex-start;
                  }

                  .image-text-content-{{ block.id }}--middle-center {
                    align-items: center;
                    justify-content: center;
                  }

                  .image-text-content-{{ block.id }}--middle-right {
                    align-items: center;
                    justify-content: flex-end;
                  }

