                    content:"";
                    width: 100%;
                    height:100%;
                    background:#000;
                    box-shadow: 0 0 20px 7px #0000004d;
                    display: block;
                    position: absolute;
                    top: 0;
                    left: 0;
                  }*/

                  .lumin-text-{{ block.id }} h2 {
                    color: {{ block.settings.head_color }};
