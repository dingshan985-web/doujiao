                 }
                 }
              </style>
              <div
                class="video-container-{{ section.id }} video-padding-{{ block.id }} column-{{ block.id }} lumin-image-{{ section.id }}{% if block.settings.small_hide %} small-hide{% endif %}{% if block.settings.medium_hide %} medium-hide{% endif %}{% if block.settings.large_up_hide %} large-up-hide{% endif %}"
