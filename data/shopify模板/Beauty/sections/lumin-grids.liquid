                 .lumin-text-{{ block.id }}:before {
                    content: "";
                    position: absolute;
                    z-index: -1;
                    top: 50%;
                    left: 50%;
                    width: 200%;
                    height: 200%;
                    {% if block.settings.opacity_color_full %}
                    background: radial-gradient(ellipse at center,{{block.settings.opacity_color}} 0%,rgba(255,255,255,0) 70%);
                    border-radius: 50%;
                    opacity: {{block.settings.overlay_opacity}}%;
                    {% endif %}
