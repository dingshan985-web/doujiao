{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    {% if section.settings.fade %}
    -webkit-mask-box-image: linear-gradient(to right, hsl(0 0% 0% / 0), hsl(0 0% 0% / 1) 20%, hsl(0 0% 0% / 1) 80%, hsl(0 0% 0% / 0));
    mask-image: linear-gradient(to right, hsl(0 0% 0% / 0), hsl(0 0% 0% / 1) 20%, hsl(0 0% 0% / 1) 80%, hsl(0 0% 0% / 0));
 {% endif %}
      }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="section-{{ section.id }}-padding">
<div class="logo-wrapper color-{{ section.settings.color_scheme }} gradient">
<style>
  .logo-wrapper {
    display: flex;
    align-items: center;
}
  .logo-bar__text-label-{{section.id}} {
    min-width: fit-content;
    font-size: {{section.settings.announcement_head_d}}px;
    line-height: {{section.settings.announcement_head_d}}px;
    padding: 0 4rem;
    color: {{section.settings.announcement_color}};
}
  @media screen and (max-width:749px){
  .logo-bar__text-label-{{section.id}}  {
    min-width: auto;
    font-size: {{section.settings.announcement_head_m}}px;
    line-height: {{section.settings.announcement_head_m}}px;
    padding: 0 1.5rem;
}
  }
</style>
  {% if section.settings.announcement_head != blank %}
<div class="logo-bar__text-label-{{section.id}} ">{{ section.settings.announcement_head }}</div>{% endif %}
<div class="announcement-bar--inner-{{ section.id }} direction-left" style="--marquee-speed: {{ section.settings.scroll_speed }}s">
     <div style="display: flex;">
       <div style="display: flex;">
        {%- for block in section.blocks -%}
          {% case block.type %}
          {% when 'image' %}
            <style>
              .announcement-bar-{{ block.id }} img {
    width: {{block.settings.logo_image_width}}px;
    height:auto;
  }
               .announcement-bar-{{ block.id }} svg {
    width: {{block.settings.logo_image_width}}px;
    height:auto;
  }
            </style>
        <div class="announcement-bar-{{ section.id }} announcement-bar-{{ block.id }}" role="region" aria-label="Announcement" {{ block.shopify_attributes }}>
          {% if block.settings.logo_image != blank %}
              {{
            block.settings.logo_image
            | image_url: width: 200
            | image_tag: loading: 'lazy'
          }}
             {%- else -%}
              <p style="font-size: 40px;margin: 0;">LOGO</p>
            {%- endif -%}
                  </div>
            
           {% when 'announcement' %}
             <style>
          .lumin-text-{{ block.id }} {
          color: {{ block.settings.announcement_color }};
          font-size: {{ block.settings.announcement_size }}px;
        }
        .lumin-text-{{ block.id }} svg {
          width: {{ block.settings.announcement_size }}px;
          height: {{ block.settings.announcement_size }}px;
        }
      @media screen and (max-width: 749px) {
         .lumin-text-{{ block.id }} {
          font-size: {{ block.settings.announcement_size_m }}px;
        }
        .lumin-text-{{ block.id }} svg {
          width: {{ block.settings.announcement_size_m }}px;
          height: {{ block.settings.announcement_size_m }}px;
        }
      }
      
      </style>
        <div class="lumin-text-{{ block.id }} announcement-bar-{{ section.id }}" role="region" aria-label="Announcement" {{ block.shopify_attributes }}>
              <a {% if block.settings.text_link != blank %}{{ block.settings.text_link }}{% else %} href="/collections/frontpage"{% endif %} class="announcement-bar__link link link--text focus-inset animate-arrow">
                {% render 'icon-accordion', icon: block.settings.icon %}  
                <p class="announcement-bar__message h6 lumin-text-{{ block.id }}">
                       {{ block.settings.Announcement }}
                      </p>
                </a>
                  </div>
          {% endcase %}
        {% endfor %}
      </div>
     </div> 

